# GEMINI_API_KEY: Chave de API para o Gemini Vision AI
# No Google AI Studio, esta chave é injetada com segurança em tempo de build/execução.
# Em ambiente local / Android Studio, copie este arquivo para .env e adicione sua chave.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Configuração Modular do Provedor de IA (permite backend proxy ou provedores alternativos)
AI_PROVIDER=GEMINI_DIRECT
AI_MODEL=gemini-2.5-flash
AI_API_URL=https://generativelanguage.googleapis.com/v1beta/
